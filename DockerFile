FROM php:8.2-apache

# 1. Instal dependensi sistem & Node.js (Cara yang benar untuk versi 20 terbaru)
RUN apt-get update && apt-get install -y \
    libpng-dev zlib1g-dev libxml2-dev libzip-dev \
    libonig-dev zip curl unzip git \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs

# 2. Instal PHP Extensions & MongoDB
RUN docker-php-ext-install pdo_mysql exif pcntl bcmath gd zip
RUN pecl install mongodb && docker-php-ext-enable mongodb

# 3. Instal Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html
COPY . .

# 4. Beri Permission untuk folder penting Laravel
RUN chown -R www-data:www-data storage bootstrap/cache || true
RUN chmod -R 775 storage bootstrap/cache || true

# 5. Konfigurasi Apache Document Root ke folder /public
ENV APACHE_DOCUMENT_ROOT /var/www/html/public
RUN sed -ri -e 's!/var/www/html!${APACHE_DOCUMENT_ROOT}!g' /etc/apache2/sites-available/*.conf
RUN sed -ri -e 's!/var/www/!${APACHE_DOCUMENT_ROOT}!g' /etc/apache2/apache2.conf /etc/apache2/conf-available/*.conf
RUN a2enmod rewrite

# 6. 🔥 FIX ERROR MPM: Hapus paksa semua MPM dan aktifkan Prefork saja 🔥
RUN rm -f /etc/apache2/mods-enabled/mpm_*.load \
    && a2enmod mpm_prefork

# 7. Build Laravel & React (Abaikan versi PHP lokal)
RUN composer install --no-interaction --prefer-dist --optimize-autoloader --no-dev --ignore-platform-reqs
RUN npm install
RUN npm run build

# 8. 🔥 FIX PORT RAILWAY: Ganti port 80 dengan $PORT dinamis milik Railway saat container berjalan 🔥
EXPOSE 80
CMD sed -i "s/80/$PORT/g" /etc/apache2/sites-available/000-default.conf /etc/apache2/ports.conf && docker-php-entrypoint apache2-foreground