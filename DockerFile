# 1. Gunakan PHP versi CLI murni
FROM php:8.2-cli

# 2. 🔥 FIX ERROR SSL MONGODB: Tambahkan libssl-dev dan pkg-config 🔥
RUN apt-get update && apt-get install -y \
    libpng-dev zlib1g-dev libxml2-dev libzip-dev \
    libonig-dev zip curl unzip git \
    libssl-dev pkg-config \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs

# 3. Instal PHP Extensions & MongoDB (Sekarang akan ter-install dengan SSL)
RUN docker-php-ext-install pdo_mysql exif pcntl bcmath gd zip
RUN pecl install mongodb && docker-php-ext-enable mongodb

# =================================================================
# 3.5. 🔥 NAIKKAN LIMIT UPLOAD PHP MENJADI 50MB 🔥
# =================================================================
RUN echo "upload_max_filesize = 50M" > /usr/local/etc/php/conf.d/uploads.ini \
    && echo "post_max_size = 50M" >> /usr/local/etc/php/conf.d/uploads.ini \
    && echo "memory_limit = 256M" >> /usr/local/etc/php/conf.d/uploads.ini \
    && echo "max_execution_time = 300" >> /usr/local/etc/php/conf.d/uploads.ini

# 4. Instal Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# 5. Set working directory
WORKDIR /app
COPY . .

# 6. Build Laravel & React
RUN composer install --no-interaction --prefer-dist --optimize-autoloader --no-dev --ignore-platform-reqs
RUN npm install
RUN npm run build

# 7. Jalankan server Laravel murni
CMD php artisan serve --host=0.0.0.0 --port=$PORT